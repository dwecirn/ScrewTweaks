# Copy this file to ".env" (same folder) and point it at your Screw Drivers install.
# The folder must contain "Screw Drivers.exe".
#
# Alternatively set the SCREWDRIVERS_DIR environment variable, which takes precedence
# over this file. An explicit -p:GameDir=<path> on the command line wins over both.
SCREWDRIVERS_DIR=E:\SteamLibrary\steamapps\common\Screw Drivers
