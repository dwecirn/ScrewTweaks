<Project>

  <PropertyGroup>
    <!--
      Default key bindings, written as UnityEngine.KeyCode member names
      (e.g. F7, F8, F9, LeftShift, Mouse0).

      These are compiled into the plugins as constants; to change one, edit it
      here and rebuild. Feature settings, including their saved state, live at
      run time in BepInEx/config/dev.dwecirn.screwtweaks.<name>.cfg.
    -->
    <PanelKey>F7</PanelKey>
    <DumpKey>F8</DumpKey>
    <TelemetryKey>F9</TelemetryKey>
  </PropertyGroup>

</Project>
